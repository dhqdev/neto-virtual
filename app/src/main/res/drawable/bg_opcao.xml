<?xml version="1.0" encoding="utf-8"?>
<!-- Opção que pode ser escolhida (ex.: velocidade da voz). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="@color/verde_claro" />
            <stroke android:width="3dp" android:color="@color/verde" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="@color/cartao" />
            <stroke android:width="1dp" android:color="@color/borda" />
        </shape>
    </item>
</selector>
